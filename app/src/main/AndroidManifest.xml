<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notifiche: avanzamento della trascrizione e testo pronto (Android 13 e successivi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Servizio di trascrizione in primo piano: elaborazione multimediale da Android 15, sincronizzazione
          dati su Android 14, e CPU sveglia mentre trascrive a schermo spento -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Nessun backup: vocali e trascrizioni sono di altre persone, i modelli sono grandi e reimportabili -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Tema.Poldo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gestione dei modelli di trascrizione: si apre dall'app e dalla tastiera di trascrizione -->
        <activity
            android:name=".modelli.ModelliActivity"
            android:exported="false"
            android:label="@string/modelli" />

        <!-- Riceve i vocali condivisi, anche più insieme, li mette in coda e si chiude subito.
              Senza finestra: non compare nelle app recenti e non porta in primo piano l'app -->
        <activity
            android:name=".condivisione.CondivisioneActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/condividi_etichetta"
            android:taskAffinity=""
            android:theme="@style/Tema.Poldo.Trasparente">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Trascrizione dei vocali in coda, in un processo separato: se il motore esaurisce
              la memoria si chiude questo processo e non l'app -->
        <service
            android:name=".servizio.ServizioTrascrizione"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync"
            android:process=":trascrizione" />

        <!-- Tastiera di sola trascrizione: ci si passa dalla propria tastiera e si torna indietro da soli -->
        <service
            android:name=".tastiera.TastieraTrascrizioni"
            android:exported="true"
            android:label="@string/tastiera_nome"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/metodo_input" />
        </service>

        <!-- Pulsante Copia della notifica con il testo pronto -->
        <receiver
            android:name=".servizio.CopiaTrascrizioneReceiver"
            android:exported="false" />

    </application>

</manifest>
